# LLM Provider Configuration
# Choose 'anthropic' or 'gemini' (default: gemini)
LLM_PROVIDER=gemini

# Anthropic API Configuration (if using anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration (if using gemini - FREE tier available!)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS (optional - comma-separated origins)
ALLOWED_ORIGINS=http://localhost:*,https://www.figma.com
